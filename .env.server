# ==================== 服务器端环境配置 ====================
# 部署到云服务器时使用此文件

# ==================== MySQL数据库配置 ====================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=你的MySQL密码
MYSQL_DATABASE=mangrove_db

# ==================== InfluxDB时序数据库配置 ====================
INFLUXDB_URL=http://localhost:8181
INFLUXDB_TOKEN=你的InfluxDB令牌
INFLUXDB_ORG=mangrove_org
INFLUXDB_BUCKET=water_quality

# InfluxDB CLI 路径（Linux 服务器上 influxdb3 安装后在 PATH 中）
INFLUXDB_CLI_PATH=influxdb3

# ==================== MQTT配置 ====================
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC=mangrove/water/+
MQTT_CLIENT_ID=mangrove_backend_server_01

# ==================== API服务配置 ====================
API_HOST=0.0.0.0
API_PORT=8000

# ==================== 图片存储配置 ====================
IMAGE_STORE_PATH=./uploads/images
